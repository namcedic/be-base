{
  "name": "be-base",
  "version": "0.0.1",
  "description": "",
  "author": "Cedric",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "schema:log": "typeorm-ts-node-commonjs -d src/databases/datasource.ts schema:log",
    "schema:drop": "typeorm-ts-node-commonjs -d src/databases/datasource.ts schema:drop",
    "schema:sync": "typeorm-ts-node-commonjs -d src/databases/datasource.ts schema:sync",
    "migration:show": "typeorm-ts-node-commonjs -d src/databases/datasource.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/databases/datasource.ts migration:run",
    "migration:run-fake": "typeorm-ts-node-commonjs -d src/databases/datasource.ts migration:run --fake",
    "migration:run-all": "typeorm-ts-node-commonjs -d src/databases/datasource.ts migration:run --transaction all",
    "migration:revert": "typeorm-ts-node-commonjs -d src/databases/datasource.ts migration:revert",
    "migration:generate": "cd src/databases/migrations && typeorm-ts-node-commonjs -d ../datasource.ts migration:generate",
    "migration:create": "cd src/databases/migrations && typeorm migration:create",
    "db:seed": "ts-node -r tsconfig-paths/register --project ./tsconfig.json ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d src/databases/datasource.ts --name ",
    "db:seed:all": "npm run db:seed src/databases/seeds/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-stringify": "^6.5.0",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express-basic-auth": "^1.2.1",
    "express-session": "^1.18.0",
    "fb": "2.0.0",
    "firebase-admin": "^12.2.0",
    "google-auth-library": "9.9.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.0",
    "ioredis": "^5.4.1",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.0",
    "nestjs-redis": "^1.3.3",
    "nextjs-cors": "^2.2.0",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.5.1",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cache-manager-redis-store": "^2.0.4",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "bcrypt": "^6.0.0",
    "env-cmd": "10.1.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.11",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@databases/(.*)$": "<rootDir>/databases/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@commons/(.*)$": "<rootDir>/commons/$1",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
